# ----- Backend (apps/api) -----
# Host/port the FastAPI process binds to when run locally
FORGEOPS_API_HOST=0.0.0.0
FORGEOPS_API_PORT=8000

# Allowed CORS origins for the web client (comma separated)
FORGEOPS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max accepted upload size in bytes (default 50 MB)
FORGEOPS_MAX_UPLOAD_BYTES=52428800

# Where SQLite lives and where ZIPs are extracted
FORGEOPS_DATA_DIR=./data
FORGEOPS_EXTRACT_DIR=./data/extracted

# ----- Frontend (apps/web) -----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
